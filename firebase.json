{
  "hosting": [
    {
      "site": "obroh",
      "public": "firebase-hosting-public",
      "headers": [
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "obroh-website",
            "region": "us-central1"
          }
        }
      ],
      "predeploy": [
        "npm run guard:deploy"
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    }
  ]
}
