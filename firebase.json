{
  "hosting": [
    {
      "site": "obroh",
      "public": "firebase-hosting-public",
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0, s-maxage=0"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "obroh-website",
            "region": "us-central1"
          }
        }
      ],
      "predeploy": [
        "npm run guard:deploy"
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    }
  ]
}
